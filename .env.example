# Copy or run npm run setup:env. No production credentials here.
DATABASE_URL=postgresql://emobility:REPLACE_WITH_RANDOM_PASSWORD@127.0.0.1:55432/emobility
POSTGRES_USER=emobility
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
POSTGRES_DB=emobility
POSTGRES_PORT=55432
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
APP_NAME=Smart E-Mobility Hub
POLL_INTERVAL_MS=10000
# Public client-side request deadline; never put secrets in VITE_* variables.
VITE_API_TIMEOUT_MS=15000
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false
LOGIN_WINDOW_MS=900000
LOGIN_MAX_ATTEMPTS=20
SEED_OPERATOR_EMAIL=operator@example.test
SEED_OPERATOR_NAME=Người vận hành demo
SEED_OPERATOR_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
SEED_STUDENT_EMAIL=student@example.test
SEED_STUDENT_NAME=Sinh viên demo
SEED_STUDENT_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
SEED_DATA_FILE=database/seed.example.json
